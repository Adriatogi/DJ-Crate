# Pinned downloads for the release app (scripts/build_release.sh). Checksums are written here,
# never fetched at build time. To bump one: download it, run `shasum -a 256 <file>`, update both lines.

# Python inside the app (python-build-standalone, fetched by uv). Keep it the same across releases
# where possible: a new Python build makes macOS ask once more for Keychain access (Spotify login).
PYTHON_VERSION=3.13.16

# ffmpeg + ffprobe: static macOS arm64 GPL builds by Martin Riedl (https://ffmpeg.martin-riedl.de)
FFMPEG_VERSION=9.1
FFMPEG_URL=https://ffmpeg.martin-riedl.de/download/macos/arm64/1795207104_9.1/ffmpeg.zip
FFMPEG_SHA256=1f66e9a690a7f1c9e60b012379f8869c11818d1797f45b21dbb2f2564ba61ae1
FFPROBE_URL=https://ffmpeg.martin-riedl.de/download/macos/arm64/1795207104_9.1/ffprobe.zip
FFPROBE_SHA256=6ef2df5f575042923a28537ab37adf936f28bf3e7b85de23a1447ed447ec1dbd
# Matching ffmpeg source, attached to each release (the GPL asks for it to be offered).
FFMPEG_SRC_URL=https://ffmpeg.org/releases/ffmpeg-9.1.tar.xz
FFMPEG_SRC_SHA256=1a4d394ae63d190a526cd052eb4415c156b5c5e2df37efab41a7de0b8fde2433

# deno: yt-dlp's JavaScript runtime for YouTube (MIT, https://github.com/denoland/deno)
DENO_VERSION=2.9.8
DENO_URL=https://github.com/denoland/deno/releases/download/v2.9.8/deno-aarch64-apple-darwin.zip
DENO_SHA256=9f0bf660393da2eaff044cdc7444cb08c73f235849b61d224d825a194ce7c98e
